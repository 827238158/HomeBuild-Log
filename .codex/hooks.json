{
  "description": "HomeBuild Log 的定向记忆检索与结束前一次性记忆审计。",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D:\\Anaconda\\python.exe -X utf8 -B \"G:\\BackUp\\AI+网络项目孵化\\HomeBuild Log\\.codex\\hooks\\memory_router.py\"",
            "statusMessage": "Retrieving relevant project memory",
            "timeout": 10,
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D:\\Anaconda\\python.exe -X utf8 -B \"G:\\BackUp\\AI+网络项目孵化\\HomeBuild Log\\.codex\\hooks\\memory_signal_collector.py\"",
            "statusMessage": "Collecting high-signal failure clues",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D:\\Anaconda\\python.exe -X utf8 -B \"G:\\BackUp\\AI+网络项目孵化\\HomeBuild Log\\.codex\\hooks\\memory_gate.py\"",
            "statusMessage": "Reviewing project memory",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
