# 项目本地运行数据与模型不得进入版本库
.local-data/
.browser-data/
.local-artifacts/

# 前端依赖、构建和工具缓存
frontend/node_modules/
frontend/dist/
.npm-cache/

# Python 缓存、测试和构建产物
__pycache__/
*.py[cod]
.pytest_cache/
pytest-cache-files-*/
.ruff_cache/
backend/tests/.tmp/
backend/tests/.runtime/
*.egg-info/
backend/build/
backend/dist/

# 本地编辑器与环境文件
.env
.env.*
!.env.example
.vscode/
.idea/

# 本地设计需求稿不进入版本库
踩坑记录-设计Brief.md

# Impeccable 临时输出与个人配置；技能和共享配置纳入版本管理
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/
