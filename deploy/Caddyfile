{
    admin off
    auto_https disable_redirects
    # IP 直连客户端可能不发送 SNI，仍需选中内网 IP 的证书。
    default_sni {$HOMEBUILD_HTTPS_HOST}
    # 容器不应尝试修改宿主机信任库；根证书由设备逐台安装。
    skip_install_trust
}

https://{$HOMEBUILD_HTTPS_HOST} {
    tls internal

    # 只让家庭网段的真实对端访问应用，避免依赖可能被 Docker 绕过的 UFW 规则。
    @home remote_ip {$HOMEBUILD_LAN_CIDR}
    handle @home {
        reverse_proxy app:8000
    }
    handle {
        respond "Forbidden" 403
    }
}
