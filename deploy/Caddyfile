{
    admin off
    auto_https disable_redirects
}

https://{$HOMEBUILD_HTTPS_HOST} {
    tls internal

    # 只让家庭网段的真实对端访问应用，避免依赖可能被 Docker 绕过的 UFW 规则。
    @home remote_ip {$HOMEBUILD_LAN_CIDR}
    handle @home {
        reverse_proxy app:8000
    }
    handle {
        respond "Forbidden" 403
    }
}
