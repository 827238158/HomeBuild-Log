HOMEBUILD_IMAGE=homebuild-log:4a-20260715
HOMEBUILD_BIND_ADDRESS=127.0.0.1
HOMEBUILD_PORT=8000

# 仅准备好 Caddy 镜像后使用 --profile https 启用；默认启动仍只有 app。
HOMEBUILD_CADDY_IMAGE=caddy:2.11.4-alpine
HOMEBUILD_HTTPS_HOST=127.0.0.1
HOMEBUILD_HTTPS_BIND_ADDRESS=127.0.0.1
HOMEBUILD_HTTPS_PORT=443
HOMEBUILD_LAN_CIDR=127.0.0.1/32

# 可选：也可继续在 .local-data/config/secrets.json 中配置 AI Key。
DEEPSEEK_API_KEY=
MIMO_API_KEY=
